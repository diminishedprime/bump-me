{
  "name": "bump-me",
  "displayName": "Bump Me",
  "description": "Get a macOS alert when Claude Code finishes a turn or needs permission while you're looking at another window.",
  "version": "1.0.2",
  "publisher": "diminishedprime",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "pnpm": ">=11",
    "vscode": "^1.137.0"
  },
  "main": "./dist/main.js",
  "imports": {
    "#src/*": "./src/*.ts",
    "#test/*": "./test/*.ts",
    "#fixtures/*": "./test/fixtures/*"
  },
  "scripts": {
    "build": "node scripts/build.mts",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies --baseContentUrl https://github.com/diminishedprime/bump-me/blob/main --baseImagesUrl https://github.com/diminishedprime/bump-me/raw/main",
    "vscode:prepublish": "pnpm build"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "devDependencies": {
    "@babel/traverse": "^8.0.7",
    "@babel/types": "^8.0.8",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@stryker-mutator/api": "^10.1.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^25.9.6",
    "@types/pngjs": "^6.0.5",
    "@types/shell-quote": "^1.7.5",
    "@types/vscode": "^1.137.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vscode/vsce": "^3.9.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "jiti": "^2.7.0",
    "memfs": "4.80.0",
    "neotraverse": "^1.0.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-sort-json": "^4.2.0",
    "semantic-release": "^25.0.9",
    "tinyglobby": "^0.2.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@abraham/reflection": "^0.13.0",
    "jsonc-parser": "^3.3.1",
    "shell-quote": "^1.12.0",
    "tsyringe": "^4.10.0",
    "zod": "^4.6.7"
  },
  "icon": "dist/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/diminishedprime/bump-me.git"
  }
}
